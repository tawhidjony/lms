{
  // ডিফল্ট ফরম্যাটার হিসেবে Prettier সেট করা
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  // ফাইল সেভ করার সাথে সাথে অটোমেটিক অব্যবহৃত ইমপোর্ট কাটা এবং ESLint ফিক্স করা
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },

  // TypeScript ও React ফাইলের জন্য সুনির্দিষ্ট ফরম্যাটার ট্যাগ
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ESLint 9 Flat Config ফাইল সঠিকভাবে রিড করার জন্য
  "eslint.experimental.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // কোটেশন বা স্ট্রিং চিহ্নের (class="") ভেতর সাজেশন চালু করা
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },

  // লিনাক্সে এডিটর ক্র্যাশ রোধ করতে ফাইল ওয়াচার এক্সক্লুড
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-entries/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true
  },

  // ফাইল অ্যাসোসিয়েশন (এটি ছাড়া Tailwind সাজেশন আসবে না)
  "files.associations": {
    "*.css": "tailwindcss",
    "*.html": "tailwindcss",
    "*.js": "javascriptreact",
    "*.jsx": "javascriptreact",
    "*.ts": "typescriptreact",
    "*.tsx": "typescriptreact"
  },

  // লিনাক্সে আননোন অ্যাট-রুলস এরর ইগনোর করা (@import "tailwindcss"; এর জন্য)
  "css.lint.unknownAtRules": "ignore",

  // প্রজেক্টের রুট ডিরেক্টরি ট্র্যাকিং অন করা
  "tailwindCSS.includeLanguages": {
    "typescriptreact": "javascriptreact",
    "javascriptreact": "javascriptreact"
  }
}
